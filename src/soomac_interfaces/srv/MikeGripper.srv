# Task 2 그리퍼 단독 제어 요청
#
# Arm Control -> Motor Control
#
# Task 2에서 마이크를 잡거나 사람에게 전달한 뒤 release하는 것처럼
# Arm trajectory와 독립적으로 그리퍼만 움직여야 할 때 사용한다.
#
# 특히 마이크 전달에서는
#
#   마이크 pick
#       -> 사람 손 위치로 이동
#       -> 일정 시간 대기
#       -> 그리퍼 release
#
# 순서가 필요하므로 trajectory 실행 안에 그리퍼 동작을 묶지 않는다.
#
# Arm Control이 전달 위치 도착 및 대기 시간을 판단한 뒤
# 필요한 시점에 이 서비스를 별도로 호출한다.


int32 goal_tick
# 그리퍼 목표 Dynamixel position tick.
#
# 예:
#   마이크 잡기  -> close tick
#   마이크 놓기  -> open tick
#
# 실제 open/close 값은 Arm Control 또는 config에서 결정한다.


float64 timeout_sec
# 그리퍼가 목표 tick에 도달하기를 기다릴 최대 시간, 단위 sec.
# 0 이하이면 Motor Control의 기본 timeout을 사용할 수 있다.


---

bool success
# true  = 목표 gripper tick 도달
# false = 통신 오류 / timeout 등으로 동작 실패


string message
# 실행 결과 또는 실패 이유.


int32 reached_tick
# 동작 종료 후 실제 gripper Present Position tick.
# 목표 위치에 제대로 도달했는지 확인하는 용도.
